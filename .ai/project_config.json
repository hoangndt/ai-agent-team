{
  "project_name": "agent-team-template",
  "default_domain": "workflow",
  "engine": {
    "default": "claude"
  },
  "git": {
    "base_branch": "main"
  },
  "autoflow": {
    "poll_interval_seconds": 15,
    "timeout_seconds": 1800
  },
  "vault": {
    "enabled": true,
    "path": ".ai/vault",
    "overview_cap_lines": 200,
    "module_cap_lines": 400,
    "inject_modules_for": ["architect", "developer", "epic_analyst", "epic_designer"]
  },
  "domains": {
    "workflow": {
      "paths": [
        ".ai/bin/",
        ".ai/agents/",
        ".ai/templates/",
        "examples/"
      ],
      "skills": {
        "architect": [
          ".ai/skills/workflow/python_orchestration/SKILL.md",
          ".ai/skills/workflow/agent_prompts/SKILL.md"
        ],
        "developer": [
          ".ai/skills/workflow/python_orchestration/SKILL.md",
          ".ai/skills/workflow/agent_prompts/SKILL.md"
        ],
        "reviewer": [
          ".ai/skills/workflow/workflow_reviewer/SKILL.md"
        ],
        "qa": [
          ".ai/skills/workflow/workflow_qa/SKILL.md"
        ]
      }
    }
  }
}
